# ===================================================================
# Felix 管理者工作台 - 运行环境配置文件 (.env)
# ===================================================================
# 部署说明:
# 1. 复制本文件重命名为 .env
# 2. 修改 APP_ENV 为对应模式
#
# 可选值:
# production - 线上生产模式 (关闭报错回显、开启静态长缓存、启用严格安全响应头)
# local      - 本地开发模式 (开启全部调试报错、静态资源禁止缓存实时重载)

APP_ENV=production
